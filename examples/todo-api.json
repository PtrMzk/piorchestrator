{
  "project_name": "todo-api",
  "description": "REST API for a todo list using TypeScript on Bun",
  "default_model": "sonnet",
  "max_concurrency": 5,
  "global_context": "Use TypeScript on Bun. Prefer built-in Bun APIs (Bun.serve, Bun.file, bun:sqlite) over third-party packages. When a dependency is truly needed, only use well-known packages with high GitHub stars and active maintenance.",
  "global_context_files": ["README.md"],
  "user_stories": [
    "User can create a new todo item via POST and receive a 201 response",
    "User can list all todos via GET and see previously created items"
  ],
  "tasks": [
    {
      "id": "init-project",
      "description": "Create package.json with bun-types, tsconfig.json with strict mode, and src/index.ts with a Bun.serve health-check endpoint returning {\"status\": \"ok\"} on GET /health",
      "dependencies": [],
      "context_files": [],
      "output_files": ["package.json", "tsconfig.json", "src/index.ts"],
      "verification": "bun test --timeout 5000",
      "priority": 10,
      "model": "sonnet",
      "max_budget_usd": 1.0,
      "tags": ["setup"]
    },
    {
      "id": "define-models",
      "description": "TDD: write failing tests in tests/models.test.ts first, then implement Todo types and validation in src/models.ts",
      "dependencies": ["init-project"],
      "context_files": [],
      "output_files": ["src/models.ts", "tests/models.test.ts"],
      "verification": "bun test tests/models.test.ts",
      "priority": 9,
      "model": "sonnet",
      "max_budget_usd": 1.0,
      "tags": ["models"]
    },
    {
      "id": "define-db",
      "description": "TDD: write failing tests in tests/database.test.ts first, then implement src/database.ts using bun:sqlite with a todos table",
      "dependencies": ["init-project"],
      "context_files": [],
      "output_files": ["src/database.ts", "tests/database.test.ts"],
      "verification": "bun test tests/database.test.ts",
      "priority": 9,
      "model": "sonnet",
      "max_budget_usd": 1.0,
      "tags": ["database"]
    },
    {
      "id": "doc-models",
      "description": "Document the models module: API surface, purpose, and integration points",
      "dependencies": ["define-models"],
      "context_files": ["src/models.ts", "tests/models.test.ts"],
      "output_files": ["docs/models.md"],
      "verification": "test -f docs/models.md",
      "priority": 7,
      "model": "sonnet",
      "max_budget_usd": 0.50,
      "tags": ["docs"]
    },
    {
      "id": "doc-db",
      "description": "Document the database module: API surface, purpose, and integration points",
      "dependencies": ["define-db"],
      "context_files": ["src/database.ts", "tests/database.test.ts"],
      "output_files": ["docs/database.md"],
      "verification": "test -f docs/database.md",
      "priority": 7,
      "model": "sonnet",
      "max_budget_usd": 0.50,
      "tags": ["docs"]
    },
    {
      "id": "crud-create",
      "description": "TDD: write failing tests first, then add POST /todos endpoint to src/routes.ts that accepts a new todo and returns 201",
      "dependencies": ["define-models", "define-db"],
      "context_files": ["src/models.ts", "src/database.ts", "docs/models.md", "docs/database.md"],
      "output_files": ["src/routes.ts", "tests/routes.test.ts"],
      "verification": "bun test tests/routes.test.ts",
      "priority": 8,
      "model": "sonnet",
      "max_budget_usd": 1.0,
      "tags": ["api", "crud"]
    },
    {
      "id": "crud-list",
      "description": "TDD: write failing tests first, then add GET /todos endpoint to src/routes.ts that returns all todos",
      "dependencies": ["define-models", "define-db"],
      "context_files": ["src/models.ts", "src/database.ts", "docs/models.md", "docs/database.md"],
      "output_files": ["src/routes.ts", "tests/routes.test.ts"],
      "verification": "bun test tests/routes.test.ts",
      "priority": 7,
      "model": "sonnet",
      "max_budget_usd": 1.0,
      "tags": ["api", "crud"]
    },
    {
      "id": "crud-update",
      "description": "TDD: write failing tests first, then add PATCH /todos/:id endpoint to src/routes.ts that updates a todo. Return 404 if not found.",
      "dependencies": ["crud-create"],
      "context_files": ["src/models.ts", "src/database.ts", "docs/models.md", "docs/database.md"],
      "output_files": ["src/routes.ts", "tests/routes.test.ts"],
      "verification": "bun test tests/routes.test.ts",
      "priority": 6,
      "model": "sonnet",
      "max_budget_usd": 1.0,
      "tags": ["api", "crud"]
    },
    {
      "id": "crud-delete",
      "description": "TDD: write failing tests first, then add DELETE /todos/:id endpoint to src/routes.ts that deletes a todo and returns 204. Return 404 if not found.",
      "dependencies": ["crud-create"],
      "context_files": ["src/models.ts", "src/database.ts", "docs/models.md", "docs/database.md"],
      "output_files": ["src/routes.ts", "tests/routes.test.ts"],
      "verification": "bun test tests/routes.test.ts",
      "priority": 6,
      "model": "sonnet",
      "max_budget_usd": 1.0,
      "tags": ["api", "crud"]
    },
    {
      "id": "doc-routes",
      "description": "Document the routes module: API surface, endpoints, and integration points",
      "dependencies": ["crud-create"],
      "context_files": ["src/routes.ts", "tests/routes.test.ts"],
      "output_files": ["docs/routes.md"],
      "verification": "test -f docs/routes.md",
      "priority": 6,
      "model": "sonnet",
      "max_budget_usd": 0.50,
      "tags": ["docs"]
    },
    {
      "id": "e2e-create-todo",
      "description": "Playwright e2e test: user can create a new todo item via POST and receive a 201 response",
      "dependencies": ["crud-create"],
      "context_files": ["src/routes.ts", "docs/routes.md"],
      "output_files": ["tests/e2e/create-todo.spec.ts"],
      "verification": "bunx playwright test tests/e2e/create-todo.spec.ts",
      "priority": 5,
      "model": "sonnet",
      "max_budget_usd": 1.0,
      "tags": ["e2e", "playwright"]
    },
    {
      "id": "e2e-list-todos",
      "description": "Playwright e2e test: user can list all todos via GET and see previously created items",
      "dependencies": ["crud-list"],
      "context_files": ["src/routes.ts", "docs/routes.md"],
      "output_files": ["tests/e2e/list-todos.spec.ts"],
      "verification": "bunx playwright test tests/e2e/list-todos.spec.ts",
      "priority": 5,
      "model": "sonnet",
      "max_budget_usd": 1.0,
      "tags": ["e2e", "playwright"]
    }
  ]
}
